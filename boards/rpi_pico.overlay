#include <zephyr/dt-bindings/pinctrl/rpi-pico-pinctrl-common.h>
#include <zephyr/dt-bindings/gpio/gpio.h>
#include <common/mem.h>

/ {
  zephyr,user{
      user-button-gpios = <&gpio0 24 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
  };
};

&uart1 {
  pinctrl-0 = <&uart1_default>;
  current-speed = <115200>;
  pinctrl-names = "default";
  status = "okay";
};

&pinctrl {
  uart1_default: uart1_default {
    group1 {
      pinmux = <UART1_TX_P4>;
    };

    group2 {
      pinmux = <UART1_RX_P5>;
      input-enable;
      bias-pull-up;
    };
  };
};


&flash0 {
  reg = < 0x10000000 DT_SIZE_M(16) >;
  ranges = < 0x0 0x10000000 DT_SIZE_M(16) >;
};

&code_partition {
  reg = <0x100 (DT_SIZE_M(16)- 0x100)>;
};
