#include <zephyr/dt-bindings/pinctrl/rpi-pico-pinctrl-common.h>
#include <zephyr/dt-bindings/gpio/gpio.h>
#include <zephyr/dt-bindings/led/led.h>
#include <common/mem.h>

/ {
  zephyr,user{
    user-button-gpios = <&gpio0 24 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
  };
};

&uart1 {
  pinctrl-0 = <&uart1_default>;
  current-speed = <115200>;
  pinctrl-names = "default";
  status = "okay";
};

&pinctrl {
  uart1_default: uart1_default {
    group1 {
      pinmux = <UART1_TX_P4>;
    };

    group2 {
      pinmux = <UART1_RX_P5>;
      input-enable;
      bias-pull-up;
    };
  };

  ws2812_default: ws2812_default {
    group1 {
      pinmux = <PIO0_P23>;
      bias-pull-down;
    };
  };
};

&pio0 {
  status = "okay";

  pio-ws2812 {
    compatible = "worldsemi,ws2812-rpi_pico-pio";

    pinctrl-0 = <&ws2812_default>;
    pinctrl-names = "default";

    bit-waveform = <3>, <3>, <4>;

    rgb_led: ws2812 {
      frequency = <800000>;
      chain-length = <1>;
      color-mapping = <LED_COLOR_ID_GREEN
                    LED_COLOR_ID_RED
                    LED_COLOR_ID_BLUE>;
      gpios = <&gpio0 23 GPIO_ACTIVE_HIGH>;
    };
  };
};

&flash0 {
  reg = < 0x10000000 DT_SIZE_M(16) >;
  ranges = < 0x0 0x10000000 DT_SIZE_M(16) >;
};

&code_partition {
  reg = <0x100 (DT_SIZE_M(16)- 0x100)>;
};
