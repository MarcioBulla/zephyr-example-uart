#include <zephyr/dt-bindings/pinctrl/rpi-pico-pinctrl-common.h>

&uart1 {
  pinctrl-0 = <&uart1_default>;
  current-speed = <115200>;
  pinctrl-names = "default";
  status = "okay";
};

&pinctrl {
  uart1_default: uart1_default {
    group1 {
      pinmux = <UART1_TX_P4>;
    };
    group2 {
      pinmux = <UART1_RX_P5>;
      input-enable;
      bias-pull-up;
    };
  };
};
